{
 "openapi": "3.0.3",
 "info": {
  "title": "Floorfy API",
  "version": "1.0.0",
  "description": "Floorfy REST API for agencies (properties, panoramas, services, users, folders, analytics, watermarks, subscription). Reconstructed from the public documentation at https://developers.floorfy.com/ : Floorfy publishes no machine-readable contract. Every call carries the token in the `tk` query parameter; most write calls are POSTs whose JSON body has a root `data` object. Browser links (tour editor, videocall, viewer) are not API calls and are not included."
 },
 "servers": [
  {
   "url": "https://api.floorfy.com/api"
  }
 ],
 "paths": {
  "/property/add": {
   "post": {
    "operationId": "createProperty",
    "summary": "Create property",
    "security": [
     {
      "AgencyToken": []
     }
    ],
    "responses": {
     "200": {
      "description": "Result",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "status": {
           "type": "integer"
          },
          "message": {
           "type": "string"
          },
          "id_floorfy": {
           "type": "integer"
          }
         }
        }
       }
      }
     }
    },
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "data": {
          "type": "object",
          "properties": {
           "id_origin": {
            "type": "string"
           },
           "property_type": {
            "type": "integer",
            "description": "1 House, 2 Flat, 3 Apartment, 4 Duplex, 5 Local, 6 Nave, 7 Office, 8 Garage, 9 Studio/Loft, 10 Penthouse, 11 Urban, 12 Urbanizable, 13 Not urbanizable, 14 Parking, 15 Storage room, 16 Living place"
           },
           "contract_type": {
            "type": "integer",
            "description": "1 Sale, 2 Renting, 3 Sold, 4 Rented"
           },
           "property_status": {
            "type": "integer",
            "description": "1 Active, 0 Archived"
           },
           "amount": {
            "type": "number"
           },
           "title": {
            "type": "string"
           },
           "description": {
            "type": "string",
            "maxLength": 4096
           },
           "rooms": {
            "type": "integer"
           },
           "bathrooms": {
            "type": "integer"
           },
           "living_area": {
            "type": "number"
           },
           "total_area": {
            "type": "number"
           },
           "location": {
            "type": "object",
            "properties": {
             "city": {
              "type": "string"
             },
             "address": {
              "type": "string"
             },
             "province": {
              "type": "string"
             },
             "number": {
              "type": "integer"
             },
             "door": {
              "type": "integer"
             },
             "floor": {
              "type": "integer"
             }
            },
            "required": [
             "city"
            ]
           },
           "photographer": {
            "type": "string",
            "description": "Email of the photographer or Floorfy username"
           },
           "time_type": {
            "type": "string",
            "enum": [
             "before",
             "after"
            ]
           },
           "agent": {
            "type": "integer"
           },
           "year_building": {
            "type": "integer"
           },
           "facilities": {
            "type": "array",
            "items": {
             "type": "integer"
            }
           },
           "id_folder": {
            "type": "integer"
           },
           "id_watermark": {
            "type": "integer",
            "nullable": true,
            "description": "Integer assigns it; null reverts to the agency default; omit for no change"
           }
          },
          "required": [
           "id_origin",
           "location"
          ]
         }
        },
        "required": [
         "data"
        ]
       }
      }
     }
    }
   }
  },
